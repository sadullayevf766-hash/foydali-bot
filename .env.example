# Bu faylni .env deb nusxalang va qiymatlarni to'ldiring.
# Windows'da: copy .env.example .env

# BotFather'dan olingan token (majburiy)
BOT_TOKEN=

# Sizning Telegram ID raqamingiz (admin huquqlari uchun).
# Bilish uchun @userinfobot ga yozing.
ADMIN_ID=

# Ixtiyoriy sozlamalar (default qiymatlar yetarli)
FREE_DAILY_LIMIT=5
PREMIUM_PRICE_STARS=25
PREMIUM_DAYS=30

# Yillik tarif
PREMIUM_YEAR_PRICE_STARS=150
PREMIUM_YEAR_DAYS=365

# Inline QR uchun yopiq kanal ID (SETUP.md ga qarang). Bo'sh bo'lsa inline QR o'chiq.
STORAGE_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# IELTS Writing tekshiruvchi bot (ixtiyoriy — bo'sh bo'lsa ishga tushmaydi)
# ─────────────────────────────────────────────────────────────

# BotFather'dan olingan IKKINCHI token (yangi bot uchun)
IELTS_BOT_TOKEN=
# Bot username'i @ siz, masalan: IeltsChecherUzBot (taklif havolasi uchun)
IELTS_BOT_USERNAME=

# Google AI Studio kaliti: https://aistudio.google.com/apikey (bepul, kartasiz)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Zaxira model (Gemini ishlamay qolsa). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# To'lov: mijoz shu kartaga o'tkazadi va chek skrinshotini botga yuboradi
CARD_NUMBER=
CARD_HOLDER=
# Muammo bo'lsa foydalanuvchi murojaat qiladigan manzil, masalan @username
ADMIN_CONTACT=

# Iqtisod (default qiymatlar yetarli)
IELTS_FREE_CHECKS=2
IELTS_REFERRAL_BONUS=1
IELTS_UNLIMITED_CAP=5
